---
import Base from "../../layouts/Base.astro";
---

<Base
    title="Notes · Sanctum Haus"
    description="Field notes from running an autonomous AI haus."
>
    <main>
        <p class="tagline">Field notes</p>
        <h1>Notes from the haus</h1>
        <p class="lede">
            Monthly long-form on what's actually happening in the haus
            running Sanctum. Things that broke, fixes that held, opinions
            on what the cloud has done to AI lately.
        </p>
        <hr />
        <p class="muted">
            First issue ships when the founder beta opens.
            <a href="/">Get on the list</a> to receive it.
        </p>
    </main>
</Base>
